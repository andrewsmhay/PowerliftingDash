# Copy this file to /etc/powerliftingdash/powerliftingdash.env and adjust
# as needed. install.sh does this for you automatically, and re-running
# install.sh to update the code never overwrites your customised copy.
#
# Same environment variables as the Docker image (see README) - the app
# reads them identically in both deployment modes.

# Where the SQLite database lives. Must be writable by the
# powerliftingdash system user (install.sh creates and chowns this).
PLD_DATA_DIR=/var/lib/powerliftingdash

# SQLite filename inside PLD_DATA_DIR.
PLD_DB_FILENAME=powerlifting_dash.sqlite3

# Interface/port uvicorn binds to. 0.0.0.0 listens on every network
# interface, including whatever address DHCP hands the host - see the
# README's "Native install on a Linux VM" section for firewall/reverse
# proxy notes before exposing this on a public IaaS host.
PLD_HOST=0.0.0.0
PLD_PORT=8080

# How often the dashboard page polls the API for fresh data (seconds).
PLD_DASHBOARD_POLL_SECONDS=60

# Used to default the date on the New entry form; overridden by the
# Timezone field on the Settings page once you've saved one.
TZ=America/Toronto
